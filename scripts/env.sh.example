# Run from the existing CUDA/Triton inference environment.
export JSON_PATH=/absolute/path/to/input/json
export MODEL_DIR=/absolute/path/to/model
export OUTPUT_DIR=/absolute/path/to/output

# A separate AlphaFold 3.0.4 environment for CPU preprocessing.
export AF3_PREPROCESS_PYTHON=/absolute/path/to/af3-3.0.4/bin/python
export AF3_DB_DIR=/absolute/path/to/public_databases

# Optional: explicitly select the existing inference environment's Python.
# export XFOLD_INFERENCE_PYTHON=/absolute/path/to/inference/bin/python

# Optional: reuse a completed preprocessing output instead of searching again.
# export XFOLD_PREPROCESSED_DIR=/absolute/path/to/preprocessed
